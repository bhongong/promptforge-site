---
import Base from '../layouts/Base.astro';
import { counts, generatedAt, sourceRoot } from '../lib/content';
import { u } from '../lib/routes';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';

const title = 'About PromptForge — Tested Prompt Templates';
const description =
  'PromptForge publishes prompt templates tested by an automated optimizer instead of assembled from other prompt lists — and says what it is not.';

const schemas = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
];
---
<Base title={title} description={description} path="/about/" schemas={schemas}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={u('/')}>Home</a> › About
    </nav>

    <h1>About PromptForge</h1>
    <p class="lead">Proven prompts, forged to work.</p>

    <section>
      <h2>What this is</h2>
      <p>
        PromptForge is a prompt library built around a working prompt-optimizer engine: each
        template is generated, then pushed through a multi-round critic loop — base draft,
        LLM polish, checklist evaluation against a target score, then improvement — and only
        ships once it clears the checklist.
      </p>
      <p>
        The current library holds {counts.prompts} templates across {counts.categories}{' '}
        categories and {counts.formulas} formulas, plus a mastered Stable Diffusion 1.5
        cinematic POV guide distilled from a 29 KB researched source document.
      </p>
    </section>

    <section>
      <h2>What this is not</h2>
      <ul>
        <li>It is not a scrape or a re-list of other people's prompts.</li>
        <li>
          It is not a promise that a prompt works with every model — templates are written for
          mainstream LLMs and for SD1.5 specifically.
        </li>
        <li>
          It is not the optimizer engine itself. The software stays internal; the products are
          the content it produced and the rubrics it used.
        </li>
      </ul>
    </section>

    <section>
      <h2>How the site is built</h2>
      <p>
        A static site generated from the same knowledge base that ships in the paid packs, so
        the free pages and the paid files can never drift apart. Every prompt is rendered into
        the HTML at build time — nothing here depends on a crawl-blocking client-side render.
      </p>
      <p class="small muted">
        Content build date {generatedAt.slice(0, 10)} · generated from{' '}
        <code>{sourceRoot}</code>.
      </p>
    </section>

    <section>
      <h2>Contact</h2>
      <p>
        Questions, corrections or a template request: email is on the
        <a href={u('/license/')}>license page</a> footer, or use the
        <a href={u('/free-starter-kit/')}>Starter Kit form</a> and reply to the delivery email.
      </p>
    </section>
  </div>
</Base>
